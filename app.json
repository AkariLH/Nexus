{
  "expo": {
    "name": "Nexus",
    "slug": "nexus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexus",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para que puedas seleccionar una foto de perfil",
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para que puedas tomar una foto de perfil",
        "NSCalendarsUsageDescription": "Necesitamos acceso a tus calendarios para sincronizar eventos con tu pareja",
        "NSRemindersUsageDescription": "Necesitamos acceso a tus recordatorios para configurar notificaciones de eventos"
      }
    },
    "android": {
      "package": "com.nexusapp.pareja",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-gradient.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withCleartextTraffic",
      "./plugins/withCxxStagingDir",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nexus usa tu ubicación solo para encontrar planes cerca de ti."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación necesita acceso a tu galería para seleccionar tu foto de perfil",
          "cameraPermission": "La aplicación necesita acceso a tu cámara para tomar tu foto de perfil"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF4F81",
          "dark": {
            "image": "./assets/images/splash-blank.png",
            "backgroundColor": "#FF4F81"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF4F81"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "252e2689-f825-4f58-af77-8d91ad93ec58"
      }
    },
    "owner": "akarilh"
  }
}
